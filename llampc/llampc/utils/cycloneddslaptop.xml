<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="any">
    <General>
      <NetworkInterfaceAddress>172.26.100.199</NetworkInterfaceAddress>
      <AllowMulticast>false</AllowMulticast>
      
      <ThreadProperties>
        <Thread name="ev">
          <Scheduling>
            <Priority>99</Priority>
            <Class>realtime</Class>
          </Scheduling>
        </Thread>
      </ThreadProperties>
    </General>

    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <Peer Address="172.26.112.71"/>
        <Peer Address="172.26.100.199"/>
      </Peers>
      <MaxAutoParticipantIndex>20</MaxAutoParticipantIndex>
    </Discovery>

    <Internal>
      <Watermarks>
        <WhcHigh>500kB</WhcHigh>
      </Watermarks>
      <MinimumRetransmitTime>5ms</MinimumRetransmitTime>
      <NackDelay>2ms</NackDelay>
    </Internal>
  </Domain>
</CycloneDDS>